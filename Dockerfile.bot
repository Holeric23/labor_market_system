FROM python:3.12-slim-bookworm
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONIOENCODING=utf-8 APP_HOME=/app
COPY requirements-bot.txt ./
RUN python -m pip install --no-cache-dir -r requirements-bot.txt && python -m pip check
COPY database/ database/
COPY bot/ bot/
USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "bot"]
